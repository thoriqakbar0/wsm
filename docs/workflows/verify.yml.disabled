name: Verify
on:
  push:
  workflow_dispatch:
    inputs:
      harbor_container:
        description: Run the optional Docker oracle trial
        required: false
        type: boolean
        default: false
jobs:
  local:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: python -m venv .venv
      - run: .venv/bin/python -m pip install -e 'packages/python[integration]'
      - run: INTEGRATION_PYTHON="$PWD/.venv/bin/python" bash scripts/verify.sh
      - run: python scripts/package_smoke.py
  harbor-container:
    if: github.event_name == 'workflow_dispatch' && inputs.harbor_container
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: python -m venv .venv
      - run: .venv/bin/python -m pip install -e 'packages/python[integration]'
      - run: .venv/bin/python scripts/prepare_harbor.py
      - run: .venv/bin/harbor run --path examples/harbor/signed-addition --agent oracle --env docker --jobs-dir jobs --job-name oracle
      - run: python scripts/check_harbor_reward.py jobs/oracle
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: harbor-oracle
          path: jobs/oracle

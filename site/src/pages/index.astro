---
import DocsLayout from '../layouts/DocsLayout.astro';
import Icon from '../components/Icon.astro';
import { Code } from 'astro:components';
const headings = [
  { depth: 2, slug: 'connect-a-model', text: 'Connect a model' },
  { depth: 2, slug: 'start-building', text: 'Start building' },
  { depth: 2, slug: 'built-for-evidence', text: 'Built for evidence' },
];
---

<DocsLayout
  title="Introduction"
  headings={headings}
  source="site/src/pages/index.astro"
>
  <div class="breadcrumb">
    Get started <span>/</span> <span>Introduction</span>
  </div>
  <article class="introduction">
    <div class="intro-title">
      <span class="section-tag">Meet WSM</span>
      <h1>
        Edit weights.
        <br />
        Keep the evidence.
      </h1>
    </div>
    <p class="lead">
      Point a model at the weights. WSM keeps a change when the loss goes down.
    </p>
    <div class="intro-actions">
      <a class="button primary" href="/docs/quickstart/">
        Start building <Icon name="arrow" size={18} />
      </a>
      <a class="text-button" href="/docs/architecture/">
        Explore the architecture <Icon name="arrow" size={16} />
      </a>
    </div>
    <figure
      class="weight-figure"
      aria-label="An AI teacher proposes a scalar weight edit. The harness evaluates the candidate and retains strict improvements."
    >
      <div class="figure-top">
        <span>
          <span class="live-dot"></span> A closer look at the weights
        </span>
        <span class="figure-label">Illustrative edit</span>
      </div>
      <div class="weight-diagram">
        <div class="diagram-source">
          <div class="network" aria-hidden="true">
            <svg viewBox="0 0 140 120">
              <g stroke="currentColor" stroke-width="1" fill="none">
                <path d="M20 35 70 20 120 60 70 60 20 35 70 100 120 60M20 85 70 20M20 85 70 60M20 85 70 100" />
              </g>
              <g fill="var(--surface)" stroke="currentColor" stroke-width="1.5">
                <circle cx="20" cy="35" r="6" />
                <circle cx="20" cy="85" r="6" />
                <circle cx="70" cy="20" r="6" />
                <circle cx="70" cy="60" r="6" />
                <circle cx="70" cy="100" r="6" />
                <circle cx="120" cy="60" r="6" />
              </g>
            </svg>
          </div>
          <strong>Target model</strong>
          <span>A fixed checkpoint</span>
        </div>
        <span class="diagram-arrow" aria-hidden="true">
          →
        </span>
        <div class="matrix-block">
          <div class="matrix" aria-hidden="true">
            {[
              '0.24',
              '−0.18',
              '0.07',
              '0.51',
              '0.32',
              '1.00',
              '−0.42',
              '0.16',
              '0.63',
            ].map((value, i) => (
              <span class={i === 5 ? 'edited-weight' : ''}>{value}</span>
            ))}
          </div>
          <strong>Explicit weight edit</strong>
          <span>One coefficient at a time</span>
        </div>
        <span class="diagram-arrow" aria-hidden="true">
          →
        </span>
        <div class="diagram-result">
          <div class="result-symbol" aria-hidden="true">
            ✓
          </div>
          <strong>Evaluate & retain</strong>
          <span>Keep strict improvements</span>
        </div>
      </div>
      <figcaption>
        <code>inspect()</code>
        <span>→</span>
        <code>propose()</code>
        <span>→</span>
        <code>evaluate()</code>
        <span>→</span>
        <code>select()</code>
      </figcaption>
    </figure>
    <section class="prose">
      <h2 id="connect-a-model">Connect a model</h2>
      <Code
        code={`python3 -m pip install -e packages/python
export WSM_TEACHER_URL="https://example.invalid"
export WSM_TEACHER_MODEL="your-model-id"
export WSM_TEACHER_API_KEY="your-key"
wsm run "Improve signed addition. Inspect the weights and test your changes." \\
  --task addition --output runs/addition`}
        lang="bash"
        themes={{ light: 'github-light', dark: 'github-dark' }}
      />
      <p>The model sends one command at a time.</p>
      <Code
        code={`{"action":"inspect","tensor":"output.weight","indices":[0,1]}
{"action":"edit","edits":[{"tensor":"output.weight","index":0,"value":1}]}`}
        lang="json"
        themes={{ light: 'github-light', dark: 'github-dark' }}
      />
      <p class="code-caption">
        WSM keeps the edit when the loss goes down.{' '}
        <a href="/docs/quickstart/">Walk through it</a>.
      </p>
    </section>
    <section>
      <h2 id="start-building">Start building</h2>
      <p class="section-description">
        Connect a model, then read the edit it made.
      </p>
      <div class="guide-grid">
        <a href="/docs/quickstart/" class="guide-card">
          <span class="guide-icon">
            <Icon name="code" />
          </span>
          <h3>
            Connect a model and edit a weight <Icon name="arrow" size={18} />
          </h3>
          <p>
            Set the endpoint, run signed addition, and read the coefficient the
            model replaced.
          </p>
          <span class="card-link">Quickstart</span>
        </a>
        <a href="/docs/wsm/" class="guide-card">
          <span class="guide-icon">
            <Icon name="book" />
          </span>
          <h3>
            Limits, recovery, and your own task <Icon name="arrow" size={18} />
          </h3>
          <p>
            Resume a run, inspect the saved report, or point the same command
            at your own task.
          </p>
          <span class="card-link">Run details</span>
        </a>
      </div>
    </section>
    <section class="prose">
      <h2 id="built-for-evidence">Built for evidence</h2>
      <div class="evidence-list">
        <div>
          <span aria-hidden="true">↳</span>
          <p>
            <strong>Explicit changes.</strong> Inspect the exact coefficients the
            model proposes to replace.
          </p>
        </div>
        <div>
          <span aria-hidden="true">↳</span>
          <p>
            <strong>Bounded experiments.</strong> Set attempt, request, and time
            limits before a run begins.
          </p>
        </div>
        <div>
          <span aria-hidden="true">↳</span>
          <p>
            <strong>Replayable results.</strong> Reconstruct the selected
            weights and verify recorded decisions without calling an evaluator.
          </p>
        </div>
      </div>
      <aside class="callout">
        <strong>Public feedback is not final proof.</strong>
        <p>
          The addition example uses public cases. Private held-out grading is a
          separate step, and lower development loss alone does not establish
          generalization. Read the <a href="/docs/research/">research scope</a>.
        </p>
      </aside>
    </section>
  </article>
</DocsLayout>

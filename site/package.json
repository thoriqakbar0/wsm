{
  "name": "wsm-docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check",
    "test": "node scripts/check-command-spelling.mjs && playwright test",
    "build:deploy": "npm run build && node scripts/package-cloudflare.mjs",
    "deploy:check": "cf deploy --prebuilt --mode production --dry-run",
    "deploy": "npm run build:deploy && cf deploy --prebuilt --mode production"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@fontsource-variable/manrope": "^5.3.0",
    "astro": "^7.4.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/build-output-utils": "0.9.10",
    "@cloudflare/config": "0.30.2",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "cf": "1.0.0-beta.28",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^5.9.3"
  }
}

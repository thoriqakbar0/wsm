{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weightless.local/schemas/v1.json",
  "title": "Weightless checkpoint v1 and experiment v2 wire data",
  "description": "Structural validation. The SDK also validates identities, graph and patch semantics, result bindings, finite policy metrics, attempt accounting, and pure recorded decisions.",
  "oneOf": [
    {
      "$ref": "#/$defs/checkpoint"
    },
    {
      "$ref": "#/$defs/proposal"
    },
    {
      "$ref": "#/$defs/task"
    },
    {
      "$ref": "#/$defs/policy"
    },
    {
      "$ref": "#/$defs/config"
    },
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/evaluation"
    },
    {
      "$ref": "#/$defs/candidate"
    },
    {
      "$ref": "#/$defs/run"
    },
    {
      "$ref": "#/$defs/development"
    }
  ],
  "$defs": {
    "tensor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shape",
        "values"
      ],
      "properties": {
        "shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1024
          },
          "minItems": 1,
          "maxItems": 2
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1.7976931348623157e+308,
            "maximum": 1.7976931348623157e+308
          },
          "minItems": 1,
          "maxItems": 100000
        }
      }
    },
    "node": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "op",
            "input",
            "weight",
            "bias"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
            },
            "op": {
              "const": "affine"
            },
            "input": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
            },
            "weight": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
            },
            "bias": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "op",
            "input"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
            },
            "op": {
              "const": "relu"
            },
            "input": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
            }
          }
        }
      ]
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputSize",
        "nodes",
        "output"
      ],
      "properties": {
        "inputSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          },
          "minItems": 1,
          "maxItems": 128
        },
        "output": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "graph",
        "tensors",
        "id"
      ],
      "properties": {
        "format": {
          "const": "weightless.checkpoint.v1"
        },
        "graph": {
          "$ref": "#/$defs/graph"
        },
        "tensors": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 100000,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/tensor"
          }
        },
        "id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "edit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tensor",
        "index",
        "value"
      ],
      "properties": {
        "tensor": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99999
        },
        "value": {
          "type": "number",
          "minimum": -1.7976931348623157e+308,
          "maximum": 1.7976931348623157e+308
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "edits",
        "author"
      ],
      "properties": {
        "base": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "edits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edit"
          },
          "minItems": 1,
          "maxItems": 100000
        },
        "author": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "target"
      ],
      "properties": {
        "input": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1.7976931348623157e+308,
            "maximum": 1.7976931348623157e+308
          },
          "minItems": 1,
          "maxItems": 1024
        },
        "target": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1.7976931348623157e+308,
            "maximum": 1.7976931348623157e+308
          },
          "minItems": 1,
          "maxItems": 1024
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "name",
        "train",
        "development",
        "budget"
      ],
      "properties": {
        "format": {
          "const": "weightless.task.v1"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
        "train": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/example"
          },
          "minItems": 1,
          "maxItems": 10000
        },
        "development": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/example"
          },
          "minItems": 1,
          "maxItems": 10000
        },
        "budget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loss",
        "rmse",
        "exact",
        "count"
      ],
      "properties": {
        "loss": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.7976931348623157e+308
        },
        "rmse": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.7976931348623157e+308
        },
        "exact": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "json": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "type": "number",
          "minimum": -1.7976931348623157e+308,
          "maximum": 1.7976931348623157e+308
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json"
          },
          "minItems": 0,
          "maxItems": 100000
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/json"
          },
          "maxProperties": 100000
        }
      ]
    },
    "jsonObject": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/json"
      },
      "maxProperties": 100000
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "metrics",
        "ties"
      ],
      "properties": {
        "format": {
          "const": "weightless.policy.v1"
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "direction"
            ],
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 256,
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*(\\.[A-Za-z][A-Za-z0-9_-]*)*$"
              },
              "direction": {
                "enum": [
                  "minimize",
                  "maximize"
                ]
              }
            }
          },
          "minItems": 1,
          "maxItems": 8
        },
        "ties": {
          "const": "retain"
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "kind",
        "purpose",
        "settings",
        "id"
      ],
      "properties": {
        "format": {
          "const": "weightless.evaluator.v1"
        },
        "kind": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
        "purpose": {
          "enum": [
            "development",
            "final"
          ]
        },
        "settings": {
          "$ref": "#/$defs/jsonObject"
        },
        "id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "run",
        "attempt",
        "checkpoint",
        "config",
        "purpose"
      ],
      "properties": {
        "format": {
          "const": "weightless.request.v1"
        },
        "run": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "attempt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "checkpoint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "config": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "purpose": {
          "enum": [
            "development",
            "final"
          ]
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "message"
      ],
      "properties": {
        "type": {
          "type": "string",
          "maxLength": 8192
        },
        "message": {
          "type": "string",
          "maxLength": 8192
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "request",
        "status",
        "native",
        "error",
        "id"
      ],
      "properties": {
        "format": {
          "const": "weightless.evaluation.v1"
        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "status": {
          "enum": [
            "completed",
            "task_failure",
            "infrastructure_error",
            "invalid_response"
          ]
        },
        "native": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reward",
            "metrics",
            "status",
            "diagnostics"
          ],
          "properties": {
            "reward": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "minimum": -1.7976931348623157e+308,
                    "maximum": 1.7976931348623157e+308
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "metrics": {
              "$ref": "#/$defs/metricTree"
            },
            "status": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "diagnostics": {
              "$ref": "#/$defs/jsonObject"
            }
          }
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/error"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "error": {
                "$ref": "#/$defs/error"
              }
            }
          }
        }
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run",
        "attempt",
        "base",
        "checkpoint"
      ],
      "properties": {
        "run": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "attempt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "base": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "checkpoint": {
          "$ref": "#/$defs/checkpoint"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt",
        "accepted",
        "reason",
        "before",
        "after",
        "evaluation",
        "incumbentEvaluation",
        "policy"
      ],
      "properties": {
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "accepted": {
          "type": "boolean"
        },
        "reason": {
          "enum": [
            "improved",
            "not_improved",
            "evaluation_failed",
            "baseline_failed"
          ]
        },
        "before": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "evaluation": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "incumbentEvaluation": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt",
        "baseAttempt",
        "proposal",
        "checkpoint",
        "evaluation",
        "decision"
      ],
      "properties": {
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "baseAttempt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "proposal": {
          "$ref": "#/$defs/proposal"
        },
        "checkpoint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "evaluation": {
          "anyOf": [
            {
              "$ref": "#/$defs/evaluation"
            },
            {
              "type": "null"
            }
          ]
        },
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/decision"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "run",
        "initial",
        "config",
        "policy",
        "budget",
        "used",
        "baseline",
        "events",
        "checkpoint",
        "provenance",
        "id"
      ],
      "properties": {
        "format": {
          "const": "weightless.run.v2"
        },
        "run": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "initial": {
          "$ref": "#/$defs/checkpoint"
        },
        "config": {
          "$ref": "#/$defs/config"
        },
        "policy": {
          "$ref": "#/$defs/policy"
        },
        "budget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "baseline": {
          "anyOf": [
            {
              "$ref": "#/$defs/evaluation"
            },
            {
              "type": "null"
            }
          ]
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "checkpoint": {
          "$ref": "#/$defs/checkpoint"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sdk",
            "version"
          ],
          "properties": {
            "sdk": {
              "const": "python"
            },
            "version": {
              "const": "0.1.0"
            }
          }
        },
        "id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "development": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "request",
        "checkpoint"
      ],
      "properties": {
        "format": {
          "const": "weightless.development.v1"
        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "checkpoint": {
          "$ref": "#/$defs/checkpoint"
        }
      }
    },
    "metricTree": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/metricTree"
          },
          {
            "type": "number",
            "minimum": -1.7976931348623157e+308,
            "maximum": 1.7976931348623157e+308
          }
        ]
      },
      "maxProperties": 100000
    }
  }
}
